# ==============================================================================
# Cloud Job Sentinel - Environment Configuration
# ==============================================================================

# --- Telegram Bot Alert Settings ---
# Create a bot via @BotFather on Telegram and get the bot token.
# To find your chat ID, message @userinfobot or invite your bot to a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Search & Scoring Configuration ---
# Comma-separated list of roles and locations to monitor on LinkedIn
SEARCH_KEYWORDS="Cloud Engineer Intern, DevOps Intern, Site Reliability Intern, Python Backend Intern, Platform Engineering Intern, Graduate Engineer Trainee Cloud"
SEARCH_LOCATIONS="India, Bengaluru, Remote"

# Minimum relevance score (0-100) to trigger a notification
MIN_MATCH_SCORE=40

# Maximum job cards to ingest per search query run
MAX_RESULTS_PER_RUN=25

# --- Execution & Operational Flags ---
# Set DRY_RUN=true to inspect parsed jobs and scores in the terminal without pinging Telegram
DRY_RUN=true

# Database storage path for hash deduplication
DATABASE_PATH=data/sentinel.db

# Headless browser mode for Playwright scraper
HEADLESS=true

# Request timeouts and delays (seconds)
REQUEST_TIMEOUT=15
PAGE_LOAD_TIMEOUT=30
RANDOM_DELAY_MIN=2.0
RANDOM_DELAY_MAX=5.0
